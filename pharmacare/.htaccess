# ── PharmaCare — protection production ──────────────────────
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blocage d'accès direct aux dossiers techniques (relatif au dossier pharmacare)
    RewriteRule ^config/ - [F]
    RewriteRule ^sql/ - [F]
    RewriteRule ^\.git - [F]
    RewriteRule ^config/\.rate_limit/ - [F]

    # Redirection HTTP → HTTPS (décommenter après activation TLS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Headers de sécurité ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS uniquement en HTTPS (décommenter après activation TLS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # CSP stricte : tout en self, polices self-hostées (pas de Google Fonts en prod)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── Fichiers sensibles à la racine : accès interdit ──────────
<FilesMatch "\.(sql|log|md|bak|env|ini)$">
    Require all denied
</FilesMatch>

# Scripts de migration/tests à la racine (au cas où ils réapparaîtraient)
<FilesMatch "^(alter_db|_mvt_check)\.(php|js)$">
    Require all denied
</FilesMatch>